---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import audioguides from '../../data/audioguides.json';
import { t, pad, paragraphs } from '../../i18n/ui';
import TorreStop from '../../components/TorreStop.astro';
import { summary, tappaJsonLd } from '../../lib/seo';

export const getStaticPaths = (() => {
  return audioguides.map((tappa) => ({
    params: { id: String(tappa.id) },
    props: { tappa },
  }));
}) satisfies GetStaticPaths;

interface Props {
  tappa: (typeof audioguides)[0];
}

const { tappa } = Astro.props;

const total = audioguides.length;
const currentIndex = audioguides.findIndex((s) => s.id === tappa.id);
const prev = currentIndex > 0 ? audioguides[currentIndex - 1] : null;
const next = currentIndex < total - 1 ? audioguides[currentIndex + 1] : null;
const stopLabel = t.stop(currentIndex + 1, total);
---

<Layout
  title={`${tappa.titolo} · Tappa ${pad(tappa.id)} — ${t.appName}, Torre Angioina`}
  description={summary(`Tappa ${currentIndex + 1} dell’audioguida della Torre Angioina di San Marco Argentano: ${tappa.posizione}. ${tappa.descrizione}`, 160)}
  jsonLd={tappaJsonLd(tappa)}
  context={stopLabel}
>
  <nav class="crumbs sheet" aria-label="Navigazione tappe">
    <a class="back mono" href="/">← {t.allStops}</a>
  </nav>

  <article class="stop sheet book" data-stop={tappa.id}>
    <header class="head">
      <p class="num mono stamp" aria-hidden="true">{pad(tappa.id)}</p>
      <h1 class="forge">{tappa.titolo}</h1>
      <p class="pos mono soft">{tappa.posizione}</p>
      <TorreStop index={currentIndex} label={t.whereYouAre(tappa.posizione)} />
    </header>

    <div class="margin meta mono soft">
      <span class="meta-st" data-meta-status>{t.statusNone}</span>
    </div>

    <button
      id="btn-ascolta"
      class="listen btn solid"
      type="button"
      data-src={tappa.audioSrc}
      data-titolo={tappa.titolo}
      data-numero={tappa.id}
      data-durata={tappa.durata}
      aria-describedby="listen-dur"
    >
      <svg class="ico ico-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3 12.5 8l-8 5z" /></svg>
      <svg class="ico ico-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2v10h-2zM9.5 3h2v10h-2z" /></svg>
      <span class="listen-label" data-listen-label>{t.listen}</span>
      <span class="listen-dur" id="listen-dur" data-listen-dur>{tappa.durata}</span>
    </button>

    <section class="tx" aria-label={t.transcript}>
      <div class="bookmark" aria-hidden="true">
        <span class="bookmark-mark" data-bookmark></span>
      </div>
      <div class="tx-body" id="tappa-article">
        {paragraphs(tappa.descrizione).map((para) => <p>{para}</p>)}
      </div>
    </section>

    <nav class="pn" aria-label={`${t.prev} / ${t.next}`}>
      {
        prev && (
          <a class="pn-card is-prev" href={`/tappa/${prev.id}/`} rel="prev">
            <span class="pn-k mono">
              <span class="pn-arr" aria-hidden="true">←</span>
              {t.prevShort}
            </span>
            <span class="pn-t">
              <span class="pn-n mono">{pad(prev.id)}</span> {prev.titolo}
            </span>
          </a>
        )
      }
      {
        next ? (
          <a class="pn-card is-next" href={`/tappa/${next.id}/`} rel="next">
            <span class="pn-k mono">
              {t.nextShort}
              <span class="pn-arr" aria-hidden="true">→</span>
            </span>
            <span class="pn-t">
              <span class="pn-n mono">{pad(next.id)}</span> {next.titolo}
            </span>
          </a>
        ) : (
          <a class="pn-card is-next" href="/">
            <span class="pn-k mono">
              {t.endShort}
              <span class="pn-arr" aria-hidden="true">→</span>
            </span>
            <span class="pn-t">{t.backHome}</span>
          </a>
        )
      }
    </nav>
  </article>
</Layout>

<script>
  import { audioStore } from '../../lib/audioStore';
  import { getStop } from '../../lib/listenState';
  import { t, fmtTime, parseDurata } from '../../i18n/ui';

  let article: HTMLElement | null = null;
  let btn: HTMLButtonElement | null = null;
  let mark: HTMLElement | null = null;
  let trackSrc: string | null = null; // absolute URL of this page's audio
  let stopId = 0;
  let autoScroll = false;

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function isThisTrack(src: string | undefined | null): boolean {
    return !!src && !!trackSrc && new URL(src, location.href).href === trackSrc;
  }

  function syncScroll(currentTime: number, duration: number): void {
    if (!autoScroll || !article || duration <= 0) return;
    const top = article.getBoundingClientRect().top + window.scrollY;
    const playerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--player-h')) || 0;
    const headerH = document.querySelector<HTMLElement>('.hd')?.offsetHeight ?? 64;
    const start = top - headerH - 24; // la prima riga resta sotto l'header, non dietro
    const end = top + article.offsetHeight - (window.innerHeight - playerH) + 120;
    if (end <= start) return; // fits on screen: nothing to scroll
    const progress = Math.min(1, currentTime / duration);
    const target = Math.max(0, start + progress * (end - start));
    window.scrollTo({ top: target, behavior: (reduceMotion() ? 'auto' : 'smooth') as ScrollBehavior });
  }

  // Segnalibro di ascolto: marker che scorre lungo il filetto a margine
  function setBookmark(fraction: number): void {
    if (!mark) return;
    const f = Math.max(0, Math.min(1, fraction));
    mark.style.setProperty('--f', String(f));
    mark.parentElement?.classList.toggle('is-on', f > 0);
  }

  // Etichetta del bottone principale secondo lo stato
  function renderButton(): void {
    if (!btn) return;
    const label = btn.querySelector('[data-listen-label]')!;
    const dur = btn.querySelector('[data-listen-dur]')!;
    const playing = audioStore.playing && isThisTrack(audioStore.current?.src);
    const saved = getStop(stopId);
    btn.classList.toggle('is-playing', playing);
    btn.setAttribute('aria-pressed', String(playing));
    if (playing) {
      label.textContent = t.pause;
    } else if (isThisTrack(audioStore.current?.src) && (saved?.t ?? 0) > 0) {
      label.textContent = t.resumeAt(fmtTime(saved!.t));
    } else if (saved && !saved.done && saved.t > 0) {
      label.textContent = t.resumeAt(fmtTime(saved.t));
    } else if (saved?.done) {
      label.textContent = t.relisten;
    } else {
      label.textContent = t.listen;
    }
    dur.textContent = btn.dataset.durata || '';

    const meta = document.querySelector<HTMLElement>('[data-meta-status]');
    if (meta) {
      meta.textContent = playing
        ? t.statusPlaying
        : saved?.done
          ? t.statusDone
          : saved && saved.t > 0
            ? t.statusStarted(fmtTime(saved.t))
            : t.statusNone;
      meta.classList.toggle('stamp', playing);
    }
  }

  // Follow the audio of THIS page only, and only while it is playing:
  // the currentTime reset after 'ended' must not scroll back to the top.
  audioStore.addEventListener('progress', (e: Event) => {
    const { currentTime, duration, src } = (e as CustomEvent).detail;
    if (src !== trackSrc) return;
    if (duration > 0) setBookmark(currentTime / duration);
    if (audioStore.playing) syncScroll(currentTime, duration);
  });

  audioStore.addEventListener('state-changed', renderButton);

  // Engage following when this page's track starts
  audioStore.addEventListener('play-tappa', (e: Event) => {
    const { src } = (e as CustomEvent).detail;
    if (isThisTrack(src)) autoScroll = true;
  });

  // Any manual scroll gesture hands control back to the user
  const release = () => { autoScroll = false; };
  window.addEventListener('wheel', release, { passive: true });
  window.addEventListener('touchmove', release, { passive: true });

  function initTappa(): void {
    btn = document.getElementById('btn-ascolta') as HTMLButtonElement | null;
    article = document.getElementById('tappa-article');
    mark = document.querySelector('[data-bookmark]');
    if (!btn) {
      trackSrc = null;
      autoScroll = false;
      return;
    }
    trackSrc = new URL(btn.dataset.src!, location.href).href;
    stopId = parseInt(btn.dataset.numero!, 10);

    // Resume following if we land on the tappa whose audio is already playing
    const current = audioStore.current;
    const playingHere = !!(audioStore.playing && current && isThisTrack(current.src));
    autoScroll = playingHere;

    // Posizione del segnalibro: punto salvato (se non conclusa)
    const saved = getStop(stopId);
    const d = parseDurata(btn.dataset.durata);
    setBookmark(saved && !saved.done && d > 0 ? saved.t / d : 0);
    renderButton();

    const b = btn;
    b.addEventListener('click', () => {
      // Se è già la traccia corrente: play/pausa senza ricaricare
      if (isThisTrack(audioStore.current?.src)) {
        audioStore.togglePlay();
        return;
      }
      audioStore.playTappa({
        src: b.dataset.src!,
        titolo: b.dataset.titolo!,
        numero: parseInt(b.dataset.numero!, 10),
        durata: b.dataset.durata,
      });
    });
  }

  // astro:page-load fires on the initial load and after every View Transition
  document.addEventListener('astro:page-load', initTappa);
</script>

<style>
  .crumbs {
    padding-top: 0.25rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .back:hover {
    color: var(--stamp);
  }

  .stop {
    padding-top: clamp(1rem, 4vw, 2.5rem);
  }

  .head .num {
    margin: 0 0 0.6rem;
    font-size: 2.25rem;
    line-height: 1;
  }

  .head h1 {
    font-size: clamp(2.4rem, 1.2rem + 5vw, 5rem);
    letter-spacing: -0.015em;
    word-spacing: 0.04em;
    font-weight: 700;
  }

  .head .pos {
    margin: 1rem 0 0;
  }

  .meta {
    display: none;
  }

  @media (min-width: 62rem) {
    .head {
      grid-row: 1;
    }

    .meta {
      grid-row: 1;
      display: flex;
      flex-direction: column;
      align-self: end;
      gap: 0.2rem;
      padding-bottom: 0.2rem;
    }
  }

  /* Azione primaria */
  .listen {
    width: 100%;
    min-height: 3.75rem;
    margin-top: 2rem;
    justify-content: flex-start;
    padding-inline: 1.25rem;
    font-size: 1rem;
  }

  .listen-label {
    flex: 1;
    text-align: left;
  }

  .listen-dur {
    opacity: 0.85;
  }

  .ico {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: miter;
    flex: none;
  }

  .ico path {
    vector-effect: non-scaling-stroke;
  }

  .ico-pause,
  .listen.is-playing .ico-play {
    display: none;
  }

  .listen.is-playing .ico-pause {
    display: block;
  }

  .listen.is-playing {
    background: var(--ink);
    border-color: var(--ink);
  }

  /* Trascrizione con segnalibro di ascolto */
  .tx {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    column-gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  @media (min-width: 62rem) {
    .tx {
      margin-left: -2rem;
      grid-template-columns: 1.25rem minmax(0, 1fr);
    }
  }

  .bookmark {
    position: relative;
  }

  .bookmark::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.5em;
    bottom: 0;
    width: 1px;
    background: var(--rule);
  }

  .bookmark-mark {
    --f: 0;
    position: absolute;
    left: calc(50% - 3.5px);
    top: calc(0.5em + var(--f) * (100% - 0.5em - 7px));
    width: 7px;
    height: 7px;
    background: var(--paper);
    border: 1px solid var(--ink);
    transition: top 0.4s linear;
  }

  .bookmark.is-on .bookmark-mark {
    background: var(--stamp);
    border-color: var(--stamp);
  }

  .tx-body {
    max-width: var(--measure);
  }

  .tx-body p:first-of-type::first-letter {
    float: left;
    font-size: 4.1em;
    line-height: 0.82;
    padding: 0.06em 0.08em 0 0;
    color: var(--stamp);
    font-weight: 500;
    font-variation-settings: 'opsz' 144;
  }

  /* Precedente / successiva: due card affiancate, la direzione è il lato.
     La precedente sta a sinistra, la successiva sempre a destra (anche alla
     prima tappa, dove la sinistra resta vuota) ed è l'unica in timbro. */
  .pn {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .pn-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.9rem;
    min-height: calc(var(--tap) * 2.25);
    padding: 0.85rem 0.9rem 1rem;
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.2s ease-out, border-color 0.2s ease-out, color 0.2s ease-out;
  }

  .pn-card.is-prev {
    grid-column: 1;
  }

  .pn-card.is-next {
    grid-column: 2;
    align-items: flex-end;
    text-align: end;
    border-color: var(--stamp);
    background: color-mix(in srgb, var(--stamp) 7%, transparent);
  }

  .pn-k {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
  }

  .is-next .pn-k,
  .is-next .pn-n {
    color: var(--stamp);
  }

  .pn-arr {
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.2s ease-out;
  }

  .pn-t {
    font-size: clamp(1.1rem, 1.02rem + 0.35vw, 1.28rem);
    line-height: 1.2;
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
    text-wrap: balance;
    hyphens: auto;
  }

  .pn-n {
    margin-right: 0.2rem;
    color: var(--ink-soft);
  }

  @media (min-width: 40rem) {
    .pn-t {
      font-size: 1.5rem;
    }
  }

  /* niente hover "appiccicoso" dopo il tocco sul telefono */
  @media (hover: hover) {
    .pn-card.is-prev:hover {
      border-color: var(--ink);
    }

    .pn-card.is-next:hover {
      background: var(--stamp);
      color: var(--paper);
    }

    .pn-card.is-next:hover :is(.pn-k, .pn-n) {
      color: var(--paper);
    }

    .is-prev:hover .pn-arr {
      transform: translateX(-3px);
    }

    .is-next:hover .pn-arr {
      transform: translateX(3px);
    }
  }
</style>
