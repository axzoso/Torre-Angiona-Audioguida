---
import Layout from '../layouts/Layout.astro';
import TappaRow from '../components/TappaRow.astro';
import TorreDrawing from '../components/TorreDrawing.astro';
import audioguides from '../data/audioguides.json';
import { t, parseDurata } from '../i18n/ui';

const totalMin = Math.round(audioguides.reduce((a, s) => a + parseDurata(s.durata), 0) / 60);
// Didascalie che accompagnano l'apertura della torre su mobile (soglie di t)
const racconto = [
  { at: 0, text: 'La Torre Angioina, XIII secolo.' },
  { at: 0.35, text: 'Scorrendo, la torre si apre in sezione.' },
  { at: 0.8, text: 'Otto tappe, dentro e intorno alla torre.' },
];
---

<Layout heroTitle>
  <section class="hero sheet">
    <div class="hero-text">
      <h1 class="title forge" data-hero-title>{t.appName}</h1>
      <p class="sub">Torre Angioina di San Marco Argentano, XIII secolo</p>
      <p class="intro">{t.intro}</p>
      <a class="resume" href="/" data-resume hidden>
        <span class="resume-k mono" data-resume-k>{t.resume}</span>
        <span class="resume-t" data-resume-t></span>
        <span class="resume-at mono" data-resume-at></span>
      </a>
    </div>
    <div class="hero-draw">
      <TorreDrawing />
    </div>
    <p class="scroll-cue mono" data-scroll-cue aria-hidden="true">
      <span>{t.scrollCue}</span>
      <span class="scroll-cue-line"></span>
    </p>
    <div class="racconto" data-racconto aria-hidden="true">
      {racconto.map((r) => (
        <p data-at={r.at}>{r.text}</p>
      ))}
    </div>
  </section>

  <section class="list sheet book" aria-labelledby="percorso">
    <h2 id="percorso" class="list-h">{t.route}</h2>
    <p class="margin mono soft">{t.routeCount(audioguides.length)} · circa {totalMin} min</p>


    <ol class="entries">
      {audioguides.map((s) => <TappaRow id={s.id} titolo={s.titolo} durata={s.durata} posizione={s.posizione} />)}
    </ol>
  </section>
</Layout>

<script>
  import { audioStore } from '../lib/audioStore';
  import { getAll } from '../lib/listenState';
  import audioguides from '../data/audioguides.json';
  import { t, pad, fmtTime } from '../i18n/ui';

  function currentId(): number | null {
    return audioStore.current ? audioStore.current.numero : null;
  }

  function render(): void {
    if (!document.querySelector('[data-stop-row]')) return; // non siamo in home
    const store = getAll();
    const playingId = audioStore.playing ? currentId() : null;

    audioguides.forEach((s) => {
      const st = store.tappe[s.id];
      const row = document.querySelector(`[data-stop-row="${s.id}"]`);
      const status = row?.querySelector<HTMLElement>('[data-status]');
      let state = '';
      let label = '';
      if (playingId === s.id) {
        state = 'playing';
        label = t.statusPlaying;
      } else if (st?.done) {
        state = 'done';
        label = t.statusDone;
      } else if (st && st.t > 0) {
        state = 'started';
        label = t.statusStarted(fmtTime(st.t));
      }
      if (status) {
        status.hidden = !state;
        status.textContent = label;
        status.dataset.state = state;
      }
    });

    // Riga "Riprendi": ultima tappa iniziata e non conclusa, altrimenti la successiva
    const resume = document.querySelector<HTMLAnchorElement>('[data-resume]');
    if (!resume) return;
    const lastId = store.last;
    const idx = audioguides.findIndex((s) => s.id === lastId);
    let target: (typeof audioguides)[number] | null = null;
    let kicker = '';
    let at = '';
    if (idx >= 0) {
      const st = store.tappe[audioguides[idx].id];
      if (st && !st.done && st.t > 0) {
        target = audioguides[idx];
        kicker = `${t.resume} · ${pad(target.id)}`;
        at = t.resumeFrom(fmtTime(st.t));
      } else if (st?.done && idx < audioguides.length - 1) {
        target = audioguides[idx + 1];
        kicker = `${t.next} · ${pad(target.id)}`;
        at = target.durata;
      }
    }
    if (target && playingId === null) {
      resume.hidden = false;
      resume.href = `/tappa/${target.id}/`;
      resume.querySelector('[data-resume-k]')!.textContent = kicker;
      resume.querySelector('[data-resume-t]')!.textContent = target.titolo;
      resume.querySelector('[data-resume-at]')!.textContent = at;
    } else {
      resume.hidden = true;
    }
  }

  audioStore.addEventListener('state-changed', render);
  document.addEventListener('astro:page-load', render);

  // Invito allo scroll: visibile solo in cima alla pagina. Su mobile, mentre
  // la torre è ferma, nel vuoto sotto il disegno scorrono le didascalie che
  // seguono l'apertura, finché arriva il percorso.
  let cueStop: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    cueStop?.abort();
    const cue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    if (!cue) return;
    cueStop = new AbortController();
    const signal = cueStop.signal;
    const mobile = matchMedia('(max-width: 51.99rem)');
    const fig = document.querySelector<HTMLElement>('[data-torre]');
    const heading = document.getElementById('percorso');
    const racconto = document.querySelector<HTMLElement>('[data-racconto]');
    const lines = racconto ? [...racconto.querySelectorAll<HTMLElement>('[data-at]')] : [];
    let t = 0;

    const listArrived = () => !!heading && heading.getBoundingClientRect().top < innerHeight - 24;
    const pinned = () => {
      if (!fig) return false;
      const pinTop = parseFloat(getComputedStyle(fig).top) || 0;
      return getComputedStyle(fig).position === 'sticky' && fig.getBoundingClientRect().top <= pinTop + 1;
    };

    const update = () => {
      cue.classList.toggle('is-gone', scrollY > 24);
      if (!racconto) return;
      const on = mobile.matches && pinned() && !listArrived();
      racconto.classList.toggle('is-on', on);
      if (on && fig) racconto.style.top = `${fig.getBoundingClientRect().bottom}px`;
      let k = 0;
      lines.forEach((l, i) => {
        if (t >= Number(l.dataset.at)) k = i;
      });
      lines.forEach((l, i) => l.classList.toggle('is-now', i === k));
    };

    document.addEventListener(
      'torre:progress',
      (e) => {
        t = (e as CustomEvent<number>).detail;
        update();
      },
      { signal },
    );
    addEventListener('scroll', update, { passive: true, signal });
    addEventListener('resize', update, { signal });
    document.addEventListener('astro:before-swap', () => cueStop?.abort(), { once: true, signal });
    update();
  });
</script>

<style>
  .hero {
    display: grid;
    gap: 1.75rem;
    padding-top: clamp(1rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 6vw, 4rem);
  }

  .title {
    font-size: clamp(3.4rem, 1rem + 7.4vw, 7.4rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .sub {
    margin: 0.9rem 0 0;
    font-style: italic;
    font-size: 1.25em;
    line-height: 1.35;
    font-variation-settings: 'opsz' 100;
    max-width: 22em;
    hyphens: manual;
  }

  .intro {
    margin: 1.4rem 0 0;
    max-width: var(--measure);
  }

  .hero-draw {
    max-width: 19rem;
    width: 100%;
    justify-self: center;
  }

  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: 3rem;
    }

    .hero-draw {
      max-width: none;
    }
  }

  /* Scorrendo, il disegno resta fermo sotto l'intestazione: nel primo mezzo
     schermo la torre ruota e si apre (TorreDrawing), poi su mobile resta
     ferma ancora un tratto (--torre-hold) mentre sotto sale il percorso. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-draw {
      --torre-hold: 30svh;
    }

    /* spaziatore (non padding: lo sticky si muove solo nell'area del contenuto) */
    .hero-draw::after {
      content: '';
      display: block;
      height: calc(55svh + var(--torre-hold));
    }

    .hero-draw > :global(.torre) {
      position: sticky;
      top: 4.5rem;
    }

    .hero-draw > :global(.torre svg) {
      max-height: calc(100svh - 7.5rem);
    }

    @media (min-width: 52rem) {
      .hero {
        align-items: start;
      }

      .hero-draw {
        --torre-hold: 0px;
      }

      .hero-text {
        position: sticky;
        top: 4.5rem;
        padding-top: clamp(2rem, 8vh, 6rem);
      }
    }
  }

  /* Invito allo scroll: in fondo allo schermo finché si è in cima alla home.
     Un filo verticale lungo cui scende un trattino in timbro. */
  .scroll-cue {
    position: fixed;
    inset-inline: 0;
    bottom: var(--player-h);
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 2.5rem 0 1rem;
    /* come l'header, ma rovesciata: il disegno sfuma sotto l'invito */
    background: linear-gradient(rgba(239, 233, 219, 0), var(--paper) 40%);
    color: var(--ink-soft);
    pointer-events: none;
    transition:
      opacity 0.4s ease-out,
      transform 0.4s ease-out;
  }

  .scroll-cue.is-gone {
    opacity: 0;
    transform: translateY(0.5rem);
  }

  .scroll-cue-line {
    position: relative;
    width: 1px;
    height: 2.25rem;
    overflow: hidden;
    background: var(--rule);
  }

  .scroll-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--stamp);
    transform: translateY(-100%) scaleY(0.35);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue {
      animation: cue-in 0.6s 1.2s ease-out backwards;
    }

    .scroll-cue-line::after {
      animation: cue-drop 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-line::after {
      transform: scaleY(0.35);
      transform-origin: top;
    }
  }

  @keyframes cue-in {
    from {
      opacity: 0;
    }
  }

  @keyframes cue-drop {
    0% {
      transform: translateY(-100%) scaleY(0.35);
    }
    60%,
    100% {
      transform: translateY(100%) scaleY(0.35);
    }
  }

  /* Su mobile: didascalie nel vuoto sotto la torre ferma, una alla volta */
  .racconto {
    position: fixed;
    inset-inline: 0;
    bottom: var(--player-h);
    z-index: 4;
    display: grid;
    place-items: center;
    padding: 0 var(--gutter) 2rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease-out;
  }

  .racconto.is-on {
    opacity: 1;
  }

  .racconto p {
    grid-area: 1 / 1;
    max-width: 17em;
    margin: 0;
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.3;
    font-variation-settings: 'opsz' 72;
    text-align: center;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
  }

  .racconto p.is-now {
    opacity: 1;
    transform: none;
  }

  .list {
    padding-top: clamp(1rem, 4vw, 2rem);
  }

  .list .margin {
    margin: -1rem 0 1.6rem;
  }

  @media (min-width: 62rem) {
    .list .margin {
      grid-row: 1;
      margin: 0.9rem 0 0;
    }
  }

  .list-h {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
    margin-bottom: 1.6rem;
  }

  /* Riprendi: unica area bordata della pagina, è un'azione */
  .resume {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'k at'
      't t';
    gap: 0.25rem 1rem;
    margin-top: 1.6rem;
    max-width: var(--measure);
    padding: 1rem 1.1rem;
    border: 1px solid var(--ink);
    text-decoration: none;
    color: var(--ink);
  }

  .resume[hidden] {
    display: none;
  }

  .resume-k {
    grid-area: k;
    color: var(--stamp);
  }

  .resume-at {
    grid-area: at;
    color: var(--ink-soft);
  }

  .resume-t {
    grid-area: t;
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
  }

  .resume:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .resume:hover .resume-k {
    color: var(--f-red);
  }

  .resume:hover .resume-at {
    color: var(--f-soft);
  }
</style>
