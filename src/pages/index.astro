---
import Layout from '../layouts/Layout.astro';
import TappaRow from '../components/TappaRow.astro';
import TorreDrawing from '../components/TorreDrawing.astro';
import audioguides from '../data/audioguides.json';
import { t, parseDurata } from '../i18n/ui';
import { homeJsonLd } from '../lib/seo';

const totalMin = Math.round(audioguides.reduce((a, s) => a + parseDurata(s.durata), 0) / 60);
---

<Layout heroTitle jsonLd={homeJsonLd(audioguides)}>
  <section class="hero sheet">
    <div class="hero-text">
      <h1 class="title forge" data-hero-title>{t.appName}</h1>
      <p class="sub">Torre Angioina di San Marco Argentano, XIII secolo</p>
      <p class="intro">{t.intro}</p>
      <a class="resume" href="/" data-resume hidden>
        <span class="resume-k mono" data-resume-k>{t.resume}</span>
        <span class="resume-t" data-resume-t></span>
        <span class="resume-at mono" data-resume-at></span>
      </a>
    </div>
    <div class="hero-draw">
      <TorreDrawing />
      <!-- su mobile l'introduzione si legge qui: le frasi salgono con lo scroll
           e si fermano sotto la torre (il testo completo resta nell'intestazione
           per gli screen reader) -->
      <div class="racconto" data-racconto aria-hidden="true">
        {
          t.introParts.map((text) => (
            <div class="frase-binario">
              <p class="frase">{text}</p>
            </div>
          ))
        }
      </div>
    </div>
    <p class="scroll-cue mono" data-scroll-cue aria-hidden="true">
      <span>{t.scrollCue}</span>
      <span class="scroll-cue-line"></span>
    </p>
  </section>

  <section class="list sheet book" aria-labelledby="percorso">
    <h2 id="percorso" class="list-h">{t.route}</h2>
    <p class="margin mono soft">{t.routeCount(audioguides.length)} · circa {totalMin} min</p>


    <ol class="entries">
      {audioguides.map((s) => <TappaRow id={s.id} titolo={s.titolo} durata={s.durata} posizione={s.posizione} />)}
    </ol>
  </section>
</Layout>

<script>
  import { audioStore } from '../lib/audioStore';
  import { getAll } from '../lib/listenState';
  import audioguides from '../data/audioguides.json';
  import { t, pad, fmtTime } from '../i18n/ui';
  import { holdHeight } from '../lib/torre/hold';

  function currentId(): number | null {
    return audioStore.current ? audioStore.current.numero : null;
  }

  function render(): void {
    if (!document.querySelector('[data-stop-row]')) return; // non siamo in home
    const store = getAll();
    const playingId = audioStore.playing ? currentId() : null;

    audioguides.forEach((s) => {
      const st = store.tappe[s.id];
      const row = document.querySelector(`[data-stop-row="${s.id}"]`);
      const status = row?.querySelector<HTMLElement>('[data-status]');
      let state = '';
      let label = '';
      if (playingId === s.id) {
        state = 'playing';
        label = t.statusPlaying;
      } else if (st?.done) {
        state = 'done';
        label = t.statusDone;
      } else if (st && st.t > 0) {
        state = 'started';
        label = t.statusStarted(fmtTime(st.t));
      }
      if (status) {
        status.hidden = !state;
        status.textContent = label;
        status.dataset.state = state;
      }
    });

    // Riga "Riprendi": ultima tappa iniziata e non conclusa, altrimenti la successiva
    const resume = document.querySelector<HTMLAnchorElement>('[data-resume]');
    if (!resume) return;
    const lastId = store.last;
    const idx = audioguides.findIndex((s) => s.id === lastId);
    let target: (typeof audioguides)[number] | null = null;
    let kicker = '';
    let at = '';
    if (idx >= 0) {
      const st = store.tappe[audioguides[idx].id];
      if (st && !st.done && st.t > 0) {
        target = audioguides[idx];
        kicker = `${t.resume} · ${pad(target.id)}`;
        at = t.resumeFrom(fmtTime(st.t));
      } else if (st?.done && idx < audioguides.length - 1) {
        target = audioguides[idx + 1];
        kicker = `${t.next} · ${pad(target.id)}`;
        at = target.durata;
      }
    }
    if (target && playingId === null) {
      resume.hidden = false;
      resume.href = `/tappa/${target.id}/`;
      resume.querySelector('[data-resume-k]')!.textContent = kicker;
      resume.querySelector('[data-resume-t]')!.textContent = target.titolo;
      resume.querySelector('[data-resume-at]')!.textContent = at;
    } else {
      resume.hidden = true;
    }
  }

  audioStore.addEventListener('state-changed', render);
  document.addEventListener('astro:page-load', render);

  // Invito allo scroll: visibile solo in cima alla pagina.
  let cueStop: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    cueStop?.abort();
    const cue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    if (!cue) return;
    cueStop = new AbortController();
    const update = () => cue.classList.toggle('is-gone', scrollY > 24);
    addEventListener('scroll', update, { passive: true, signal: cueStop.signal });
    document.addEventListener('astro:before-swap', () => cueStop?.abort(), { once: true, signal: cueStop.signal });
    update();
  });

  // Racconto (mobile): l'introduzione, divisa in frasi, scorre con la pagina.
  // Ogni frase entra dal basso, sale e si ferma sotto la torre ferma, sotto la
  // precedente; quando la torre riparte, il paragrafo ricomposto va via con lei.
  // Lo fa il browser con position: sticky: ogni frase sta in un "binario"
  // (assoluto dentro .hero-draw) che decide dove parte, dove si ferma e quando
  // riparte; qui si calcolano solo le misure, nessun lavoro durante lo scroll.
  let raccStop: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    raccStop?.abort();
    const hero = document.querySelector<HTMLElement>('.hero');
    const fig = document.querySelector<HTMLElement>('[data-torre]');
    const box = fig?.parentElement;
    const racconto = document.querySelector<HTMLElement>('[data-racconto]');
    if (!hero || !fig || !box || !racconto) return;
    const binari = [...racconto.querySelectorAll<HTMLElement>('.frase-binario')];
    const frasi = binari.map((b) => b.querySelector<HTMLElement>('.frase')!);
    const mobile = matchMedia('(max-width: 51.99rem)');
    const calma = matchMedia('(prefers-reduced-motion: reduce)');
    const GAP_TOP = 18; // px tra la torre e la prima frase
    const GAP = 6; // px tra una frase e l'altra
    const GAP_END = 28; // px tra il paragrafo e il percorso

    const reset = () => {
      hero.classList.remove('has-racconto');
      box.style.removeProperty('--racconto-h');
    };

    const layout = () => {
      if (!mobile.matches || calma.matches) return reset();
      hero.classList.add('has-racconto');
      const pinTop = parseFloat(getComputedStyle(fig).top) || 0;
      const figH = fig.offsetHeight;
      const hs = frasi.map((f) => f.offsetHeight);
      const docks: number[] = [];
      hs.forEach((_, i) => docks.push(i === 0 ? GAP_TOP : docks[i - 1] + hs[i - 1] + GAP));
      const textH = docks[docks.length - 1] + hs[hs.length - 1];
      // schermo troppo basso per il paragrafo sotto la torre: testo in alto
      if (pinTop + figH + textH > innerHeight - 8) return reset();
      box.style.setProperty('--racconto-h', `${textH + GAP_END}px`);
      // altezza del contenuto di .hero-draw (torre + tratto in cui resta ferma)
      const cs = getComputedStyle(box);
      const content = box.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
      // Le frasi arrivano mentre la torre si apre: l'ultima si ferma sotto la
      // terza esattamente quando finisce l'animazione, cioè alla fine del
      // tratto fermo meno la sosta finale (--torre-hold, misurata come fa
      // TorreDrawing per calcolare l'animazione).
      const anim = content - figH - holdHeight(box); // scroll dell'animazione a torre ferma
      const step = anim / frasi.length;
      binari.forEach((b, i) => {
        const offset = (i + 1) * step; // scroll, da quando la torre si ferma, in cui la frase si ferma
        const top = figH + docks[i] + offset;
        const bottom = content + docks[i] + hs[i]; // riparte insieme alla torre
        b.style.top = `${top}px`;
        b.style.height = `${bottom - top}px`;
        frasi[i].style.top = `${pinTop + figH + docks[i]}px`;
      });
    };

    raccStop = new AbortController();
    const signal = raccStop.signal;
    addEventListener('resize', layout, { signal });
    mobile.addEventListener('change', layout, { signal });
    calma.addEventListener('change', layout, { signal });
    document.fonts?.ready.then(() => !signal.aborted && layout());
    document.addEventListener('astro:before-swap', () => raccStop?.abort(), { once: true, signal });
    layout();
  });
</script>

<style>
  .hero {
    display: grid;
    gap: 1.75rem;
    padding-top: clamp(1rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 6vw, 4rem);
  }

  .title {
    font-size: clamp(3.4rem, 1rem + 7.4vw, 7.4rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .sub {
    margin: 0.9rem 0 0;
    font-style: italic;
    font-size: 1.25em;
    line-height: 1.35;
    font-variation-settings: 'opsz' 100;
    max-width: 22em;
    hyphens: manual;
  }

  .intro {
    margin: 1.4rem 0 0;
    max-width: var(--measure);
  }

  .hero-draw {
    max-width: 19rem;
    width: 100%;
    justify-self: center;
  }

  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      column-gap: 3rem;
    }

    .hero-draw {
      max-width: none;
    }
  }

  /* Scorrendo, il disegno resta fermo sotto l'intestazione: nel primo mezzo
     schermo la torre ruota e si apre (TorreDrawing), poi su mobile resta
     ferma ancora un tratto (--torre-hold) a torre aperta e paragrafo
     ricomposto, prima che arrivi il percorso. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-draw {
      --torre-hold: 25svh;
    }

    /* spaziatore (non padding: lo sticky si muove solo nell'area del contenuto) */
    .hero-draw::after {
      content: '';
      display: block;
      height: calc(55svh + var(--torre-hold));
    }

    .hero-draw > :global(.torre) {
      position: sticky;
      top: 4.5rem;
    }

    .hero-draw > :global(.torre svg) {
      max-height: calc(100svh - 7.5rem);
    }

    @media (min-width: 52rem) {
      .hero {
        align-items: start;
      }

      .hero-draw {
        --torre-hold: 0px;
      }

      .hero-text {
        position: sticky;
        top: 4.5rem;
        padding-top: clamp(2rem, 8vh, 6rem);
      }
    }
  }

  /* Invito allo scroll: in fondo allo schermo finché si è in cima alla home.
     Un filo verticale lungo cui scende un trattino in timbro. */
  .scroll-cue {
    position: fixed;
    inset-inline: 0;
    bottom: var(--player-h);
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 2.5rem 0 1rem;
    /* come l'header, ma rovesciata: il disegno sfuma sotto l'invito */
    background: linear-gradient(rgba(239, 233, 219, 0), var(--paper) 40%);
    color: var(--ink-soft);
    pointer-events: none;
    transition:
      opacity 0.4s ease-out,
      transform 0.4s ease-out;
  }

  .scroll-cue.is-gone {
    opacity: 0;
    transform: translateY(0.5rem);
  }

  .scroll-cue-line {
    position: relative;
    width: 1px;
    height: 2.25rem;
    overflow: hidden;
    background: var(--rule);
  }

  .scroll-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--stamp);
    transform: translateY(-100%) scaleY(0.35);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue {
      animation: cue-in 0.6s 1.2s ease-out backwards;
    }

    .scroll-cue-line::after {
      animation: cue-drop 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-line::after {
      transform: scaleY(0.35);
      transform-origin: top;
    }
  }

  @keyframes cue-in {
    from {
      opacity: 0;
    }
  }

  @keyframes cue-drop {
    0% {
      transform: translateY(-100%) scaleY(0.35);
    }
    60%,
    100% {
      transform: translateY(100%) scaleY(0.35);
    }
  }

  /* Racconto (mobile, con l'animazione): le frasi dell'introduzione salgono
     con lo scroll e si fermano sotto la torre. Misure e posizioni dei binari
     le calcola lo script; senza script resta l'introduzione in alto. */
  .racconto {
    display: none;
  }

  .hero.has-racconto .hero-draw {
    position: relative;
    /* padding, non contenuto: lo spazio del paragrafo non allunga la sosta */
    padding-bottom: var(--racconto-h, 0px);
  }

  .hero.has-racconto .racconto {
    display: block;
    position: absolute;
    top: 0;
    bottom: 0;
    /* largo quanto la pagina, non quanto il disegno */
    left: 50%;
    width: calc(100vw - 2 * var(--gutter));
    margin-left: calc((100vw - 2 * var(--gutter)) / -2);
    pointer-events: none;
  }

  .frase-binario {
    position: absolute;
    inset-inline: 0;
  }

  .frase {
    position: sticky;
    max-width: 17em;
    margin: 0 auto;
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.3;
    font-variation-settings: 'opsz' 72;
    text-align: center;
    text-wrap: balance;
  }

  /* l'introduzione in alto resta solo per gli screen reader */
  .hero.has-racconto .intro {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .list {
    padding-top: clamp(1rem, 4vw, 2rem);
  }

  .list .margin {
    margin: -1rem 0 1.6rem;
  }

  @media (min-width: 62rem) {
    .list .margin {
      grid-row: 1;
      margin: 0.9rem 0 0;
    }
  }

  .list-h {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem);
    margin-bottom: 1.6rem;
  }

  /* Riprendi: unica area bordata della pagina, è un'azione */
  .resume {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'k at'
      't t';
    gap: 0.25rem 1rem;
    margin-top: 1.6rem;
    max-width: var(--measure);
    padding: 1rem 1.1rem;
    border: 1px solid var(--ink);
    text-decoration: none;
    color: var(--ink);
  }

  .resume[hidden] {
    display: none;
  }

  .resume-k {
    grid-area: k;
    color: var(--stamp);
  }

  .resume-at {
    grid-area: at;
    color: var(--ink-soft);
  }

  .resume-t {
    grid-area: t;
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
  }

  .resume:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .resume:hover .resume-k {
    color: var(--f-red);
  }

  .resume:hover .resume-at {
    color: var(--f-soft);
  }
</style>
