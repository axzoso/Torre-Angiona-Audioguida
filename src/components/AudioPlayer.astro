---
// No server-side props needed — purely client-side
---

<div
  id="audio-player"
  transition:persist
  transition:name="audio-player"
  class="fixed bottom-0 left-0 right-0 z-50 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-label="Player audio"
  aria-hidden="true"
>
  <div
    class="bg-[#0A0A0A]/95 backdrop-blur-xl border-t border-white/[0.08] px-4 pt-3"
    style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px))"
  >
    <!-- Row 1: info + controls -->
    <div class="flex items-center gap-3 max-w-lg mx-auto">
      <!-- Numero tappa -->
      <span
        id="player-numero"
        class="font-mono font-bold text-lg shrink-0 w-6 text-center"
        style="color: var(--accent)"
      >1</span>

      <!-- Titolo (truncated) -->
      <span id="player-titolo" class="text-sm truncate flex-1" style="color: var(--text-primary)">
        —
      </span>

      <!-- Controls -->
      <div class="flex items-center gap-1 shrink-0">
        <button
          id="btn-back"
          aria-label="Indietro 15 secondi"
          class="flex flex-col items-center justify-center w-9 h-9 rounded-full hover:bg-white/10 transition-colors text-xs font-mono"
          style="color: var(--text-secondary)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mb-0.5">
            <path d="M12 5V2L8 6l4 4V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
          </svg>
          <span class="leading-none">15</span>
        </button>

        <button
          id="btn-play"
          aria-label="Play"
          class="w-10 h-10 rounded-full flex items-center justify-center transition-colors"
          style="background-color: var(--accent)"
        >
          <svg id="icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <polygon points="6,3 20,12 6,21"/>
          </svg>
          <svg id="icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 hidden">
            <rect x="6" y="4" width="4" height="16"/>
            <rect x="14" y="4" width="4" height="16"/>
          </svg>
        </button>

        <button
          id="btn-forward"
          aria-label="Avanti 15 secondi"
          class="flex flex-col items-center justify-center w-9 h-9 rounded-full hover:bg-white/10 transition-colors text-xs font-mono"
          style="color: var(--text-secondary)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mb-0.5">
            <path d="M12 5V2l4 4-4 4V7c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6h2c0 4.42-3.58 8-8 8s-8-3.58-8-8 3.58-8 8-8z"/>
          </svg>
          <span class="leading-none">15</span>
        </button>
      </div>
    </div>

    <!-- Row 2: progress -->
    <div class="flex items-center gap-2 max-w-lg mx-auto mt-2">
      <span id="player-current" class="text-xs font-mono w-9 shrink-0" style="color: var(--text-secondary)">0:00</span>
      <input
        type="range"
        id="progress-bar"
        min="0"
        max="100"
        value="0"
        step="0.1"
        class="flex-1 h-1 cursor-pointer"
        aria-label="Posizione audio"
      />
      <span id="player-duration" class="text-xs font-mono w-9 shrink-0 text-right" style="color: var(--text-secondary)">0:00</span>
    </div>
  </div>

  <audio id="audio-element" preload="metadata"></audio>
</div>

<script>
  import { audioStore } from '../lib/audioStore';

  const player = document.getElementById('audio-player') as HTMLDivElement;
  const audio = document.getElementById('audio-element') as HTMLAudioElement;
  const btnPlay = document.getElementById('btn-play') as HTMLButtonElement;
  const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
  const btnFwd = document.getElementById('btn-forward') as HTMLButtonElement;
  const progressBar = document.getElementById('progress-bar') as HTMLInputElement;
  const elCurrent = document.getElementById('player-current') as HTMLSpanElement;
  const elDuration = document.getElementById('player-duration') as HTMLSpanElement;
  const elTitolo = document.getElementById('player-titolo') as HTMLSpanElement;
  const elNumero = document.getElementById('player-numero') as HTMLSpanElement;
  const iconPlay = document.getElementById('icon-play') as HTMLElement;
  const iconPause = document.getElementById('icon-pause') as HTMLElement;

  // Fallback duration (seconds) from the tappa metadata, used when the browser
  // reports duration as Infinity/NaN (common for MP3s served from the SW cache).
  let knownDuration = 0;

  function fmt(s: number): string {
    if (isNaN(s) || !isFinite(s)) return '0:00';
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${m}:${sec.toString().padStart(2, '0')}`;
  }

  function parseDurata(str: string | undefined): number {
    if (!str) return 0;
    const parts = str.split(':').map(Number);
    if (parts.some(isNaN)) return 0;
    return parts.reduce((acc, n) => acc * 60 + n, 0);
  }

  // Prefer the real duration; fall back to the known value when it is unusable.
  function effectiveDuration(): number {
    return isFinite(audio.duration) && audio.duration > 0 ? audio.duration : knownDuration;
  }

  function showPlayer(): void {
    player.classList.remove('opacity-0', 'pointer-events-none');
    player.setAttribute('aria-hidden', 'false');
    document.body.classList.add('player-active');
  }

  function setPlayingUI(playing: boolean): void {
    if (playing) {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      btnPlay.setAttribute('aria-label', 'Pausa');
    } else {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      btnPlay.setAttribute('aria-label', 'Play');
    }
  }

  let currentTrackSrc: string | null = null;

  // Listen for play-tappa events from pages
  audioStore.addEventListener('play-tappa', async (e: Event) => {
    const { src, titolo, numero, durata } = (e as CustomEvent<{ src: string; titolo: string; numero: number; durata?: string }>).detail;
    const resolvedSrc = new URL(src, window.location.href).href;
    currentTrackSrc = resolvedSrc;

    elTitolo.textContent = titolo;
    elNumero.textContent = String(numero);
    knownDuration = parseDurata(durata);
    elDuration.textContent = fmt(effectiveDuration());
    showPlayer();

    // Invio evento a Google Analytics (GA4)
    if (typeof window !== 'undefined' && typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'play_audio', {
        'audio_title': titolo,
        'audio_id': numero,
        'audio_src': src
      });
    }

    try {
      // FONDAMENTALE: Aggiriamo il blocco delle "Range Requests" di Safari e Workbox
      // effettuando una normale fetch(). Workbox intercetterà questa fetch e 
      // restituirà istantaneamente il file MP3 intero dalla cache locale.
      const response = await fetch(resolvedSrc);
      const blob = await response.blob();
      const objectUrl = URL.createObjectURL(blob);
      
      // Pulizia della memoria dal blob precedente
      if (audio.src && audio.src.startsWith('blob:')) {
        URL.revokeObjectURL(audio.src);
      }
      
      audio.src = objectUrl;
      audio.load();
      audio.play().catch(() => {/* browser may block autoplay */});
    } catch (err) {
      // Fallback tradizionale
      if (audio.src !== resolvedSrc) {
        audio.src = resolvedSrc;
        audio.load();
      }
      audio.play().catch(() => {/* browser may block autoplay */});
    }
  });

  // Listen for toggle-play events
  audioStore.addEventListener('toggle-play', () => {
    if (audio.paused) {
      audio.play().catch(() => {});
    } else {
      audio.pause();
    }
  });

  // Listen for seek-relative events
  audioStore.addEventListener('seek-relative', (e: Event) => {
    const { seconds } = (e as CustomEvent<{ seconds: number }>).detail;
    const max = effectiveDuration() || Infinity;
    audio.currentTime = Math.max(0, Math.min(max, audio.currentTime + seconds));
  });

  // The player persists across View Transitions but the body is swapped,
  // so re-apply the spacing class when the player is still visible.
  document.addEventListener('astro:after-swap', () => {
    if (!player.classList.contains('opacity-0')) {
      document.body.classList.add('player-active');
    }
  });

  // Player button handlers
  btnPlay.addEventListener('click', () => audioStore.togglePlay());
  btnBack.addEventListener('click', () => audioStore.seekRelative(-15));
  btnFwd.addEventListener('click', () => audioStore.seekRelative(15));

  // Sync progress bar with audio
  audio.addEventListener('timeupdate', () => {
    const d = effectiveDuration();
    if (d > 0) {
      progressBar.value = String(Math.min(100, (audio.currentTime / d) * 100));
      elCurrent.textContent = fmt(audio.currentTime);
      audioStore.reportProgress(audio.currentTime, d, currentTrackSrc || audio.src);
    }
  });

  audio.addEventListener('loadedmetadata', () => {
    elDuration.textContent = fmt(effectiveDuration());
  });

  // Duration may only become known after buffering; update the display then.
  audio.addEventListener('durationchange', () => {
    if (isFinite(audio.duration) && audio.duration > 0) {
      elDuration.textContent = fmt(audio.duration);
    }
  });

  audio.addEventListener('play', () => {
    setPlayingUI(true);
    audioStore.reportState(true, currentTrackSrc || audio.src);
  });

  audio.addEventListener('pause', () => {
    setPlayingUI(false);
    audioStore.reportState(false, currentTrackSrc || audio.src);

    // Invia evento di pausa (escludendo quando l'audio è terminato)
    const dur = effectiveDuration();
    if (dur > 0 && audio.currentTime < dur - 0.5) {
      if (typeof window !== 'undefined' && typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'audio_pause', {
          'audio_title': elTitolo.textContent,
          'audio_id': parseInt(elNumero.textContent || '0', 10),
          'audio_position': Math.round(audio.currentTime)
        });
      }
    }
  });

  audio.addEventListener('ended', () => {
    setPlayingUI(false);
    progressBar.value = '0';
    audio.currentTime = 0;
    audioStore.reportState(false, currentTrackSrc || audio.src);

    // Invia evento di completamento audio
    if (typeof window !== 'undefined' && typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'audio_complete', {
        'audio_title': elTitolo.textContent,
        'audio_id': parseInt(elNumero.textContent || '0', 10),
        'audio_src': currentTrackSrc || audio.src
      });
    }
  });

  // Allow scrubbing via progress bar
  progressBar.addEventListener('input', () => {
    const d = effectiveDuration();
    if (d > 0) {
      audio.currentTime = (Number(progressBar.value) / 100) * d;
    }
  });
</script>
