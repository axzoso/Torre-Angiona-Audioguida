---
import { t } from '../i18n/ui';
---

<div
  id="audio-player"
  class="pl"
  transition:persist
  transition:name="audio-player"
  role="region"
  aria-label={t.player}
  aria-hidden="true"
  inert
>
  <div class="pl-in">
    <input
      type="range"
      id="progress-bar"
      class="pl-bar"
      min="0"
      max="100"
      value="0"
      step="0.1"
      aria-label={t.position}
    />

    <div class="pl-info">
      <a id="player-link" class="pl-now" href="/">
        <span id="player-numero" class="pl-num">01</span>
        <span id="player-titolo" class="pl-title">—</span>
      </a>
      <span class="pl-time">
        <span id="player-current">0:00</span><span class="pl-sep"> / </span><span id="player-duration">0:00</span>
      </span>
    </div>

    <div class="pl-ctrl">
      <button id="btn-rate" class="pl-btn" type="button" aria-label={t.speed('1×')}>1×</button>
      <button id="btn-back" class="pl-btn" type="button" aria-label={t.back15}>−15</button>
      <button id="btn-play" class="pl-play" type="button" aria-label={t.play}>
        <svg id="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3 12.5 8l-8 5z" /></svg>
        <svg id="icon-pause" class="is-hidden" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2v10h-2zM9.5 3h2v10h-2z" /></svg>
      </button>
      <button id="btn-forward" class="pl-btn" type="button" aria-label={t.fwd15}>+15</button>
      <button id="btn-next" class="pl-btn pl-next" type="button" disabled>
        <span id="next-num">—</span> <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <audio id="audio-element" preload="metadata"></audio>
</div>

<script>
  import { navigate } from 'astro:transitions/client';
  import { audioStore, type TappaInfo } from '../lib/audioStore';
  import { getStop, savePosition, markDone, getRate, setRate } from '../lib/listenState';
  import audioguides from '../data/audioguides.json';
  import { t, pad, fmtTime, parseDurata } from '../i18n/ui';

  const player = document.getElementById('audio-player') as HTMLDivElement;
  const audio = document.getElementById('audio-element') as HTMLAudioElement;
  const btnPlay = document.getElementById('btn-play') as HTMLButtonElement;
  const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
  const btnFwd = document.getElementById('btn-forward') as HTMLButtonElement;
  const btnRate = document.getElementById('btn-rate') as HTMLButtonElement;
  const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
  const elNextNum = document.getElementById('next-num') as HTMLSpanElement;
  const progressBar = document.getElementById('progress-bar') as HTMLInputElement;
  const elCurrent = document.getElementById('player-current') as HTMLSpanElement;
  const elDuration = document.getElementById('player-duration') as HTMLSpanElement;
  const elTitolo = document.getElementById('player-titolo') as HTMLSpanElement;
  const elNumero = document.getElementById('player-numero') as HTMLSpanElement;
  const elLink = document.getElementById('player-link') as HTMLAnchorElement;
  const iconPlay = document.getElementById('icon-play') as unknown as SVGElement;
  const iconPause = document.getElementById('icon-pause') as unknown as SVGElement;

  const RATES = [1, 1.25, 1.5, 0.75];
  const gtag = (...args: unknown[]) => {
    const g = (window as any).gtag;
    if (typeof g === 'function') g(...args);
  };

  // Fallback duration (seconds) from the tappa metadata, used when the browser
  // reports duration as Infinity/NaN (common for MP3s served from the SW cache).
  let knownDuration = 0;
  let currentTrackSrc: string | null = null;
  let currentId = 0;
  let pendingSeek = 0; // posizione da cui riprendere dopo il caricamento
  let lastSaved = 0;

  function effectiveDuration(): number {
    return isFinite(audio.duration) && audio.duration > 0 ? audio.duration : knownDuration;
  }

  function nextOf(id: number) {
    const i = audioguides.findIndex((s) => s.id === id);
    return i >= 0 && i < audioguides.length - 1 ? audioguides[i + 1] : null;
  }

  function prevOf(id: number) {
    const i = audioguides.findIndex((s) => s.id === id);
    return i > 0 ? audioguides[i - 1] : null;
  }

  function infoFor(s: (typeof audioguides)[number]): TappaInfo {
    return { src: s.audioSrc, titolo: s.titolo, numero: s.id, durata: s.durata };
  }

  // Lo spazio riservato in fondo alla pagina segue l'altezza reale del player
  const ro = new ResizeObserver(() => {
    if (player.classList.contains('is-on')) {
      document.documentElement.style.setProperty('--player-h', `${player.offsetHeight}px`);
    }
  });
  ro.observe(player);

  function showPlayer(): void {
    player.classList.add('is-on');
    player.removeAttribute('inert');
    player.setAttribute('aria-hidden', 'false');
    document.documentElement.style.setProperty('--player-h', `${player.offsetHeight}px`);
    document.body.classList.add('player-active');
  }

  function setPlayingUI(playing: boolean): void {
    iconPlay.classList.toggle('is-hidden', playing);
    iconPause.classList.toggle('is-hidden', !playing);
    btnPlay.setAttribute('aria-label', playing ? t.pause : t.play);
    player.classList.toggle('is-playing', playing);
    if ('mediaSession' in navigator) navigator.mediaSession.playbackState = playing ? 'playing' : 'paused';
  }

  function setProgress(time: number, d: number): void {
    const p = d > 0 ? Math.min(100, (time / d) * 100) : 0;
    progressBar.value = String(p);
    progressBar.style.setProperty('--p', `${p}%`);
    elCurrent.textContent = fmtTime(time);
  }

  function applyRate(r: number): void {
    audio.playbackRate = r;
    audio.defaultPlaybackRate = r;
    const label = `${String(r).replace('.', ',')}×`;
    btnRate.textContent = label;
    btnRate.setAttribute('aria-label', t.speed(label));
  }

  function renderNext(): void {
    const n = nextOf(currentId);
    btnNext.disabled = !n;
    elNextNum.textContent = n ? pad(n.id) : '—';
    btnNext.setAttribute('aria-label', n ? t.goNext(pad(n.id), n.titolo) : t.end);
  }

  function persist(force = false): void {
    if (!currentId) return;
    const now = Date.now();
    if (!force && now - lastSaved < 4000) return;
    lastSaved = now;
    if (audio.currentTime > 0) savePosition(currentId, audio.currentTime);
  }

  function updateMediaSession(): void {
    if (!('mediaSession' in navigator)) return;
    navigator.mediaSession.metadata = new MediaMetadata({
      title: `${pad(currentId)} · ${elTitolo.textContent ?? ''}`,
      artist: `${t.appName} — ${t.org}`,
      album: 'Torre Angioina · San Marco Argentano',
      artwork: [
        { src: '/icons/icon-192.png', sizes: '192x192', type: 'image/png' },
        { src: '/icons/icon-512.png', sizes: '512x512', type: 'image/png' },
      ],
    });
  }

  function updatePositionState(): void {
    if (!('mediaSession' in navigator) || !navigator.mediaSession.setPositionState) return;
    const d = effectiveDuration();
    if (!(d > 0)) return;
    try {
      navigator.mediaSession.setPositionState({
        duration: d,
        playbackRate: audio.playbackRate,
        position: Math.min(audio.currentTime, d),
      });
    } catch {
      /* alcuni browser rifiutano valori transitori */
    }
  }

  applyRate(getRate());

  // Listen for play-tappa events from pages
  audioStore.addEventListener('play-tappa', async (e: Event) => {
    const { src, titolo, numero, durata } = (e as CustomEvent<TappaInfo>).detail;
    const resolvedSrc = new URL(src, window.location.href).href;

    // Salva dove si era arrivati nella traccia precedente
    persist(true);

    currentTrackSrc = resolvedSrc;
    currentId = numero;
    lastSaved = 0;

    elTitolo.textContent = titolo;
    elNumero.textContent = pad(numero);
    elLink.href = `/tappa/${numero}/`;
    elLink.setAttribute('aria-label', t.openStop(pad(numero)));
    knownDuration = parseDurata(durata);
    elDuration.textContent = fmtTime(knownDuration);
    setProgress(0, knownDuration);
    player.classList.remove('is-ended');
    renderNext();
    showPlayer();
    updateMediaSession();

    // Ripresa: solo se la tappa era stata interrotta (non conclusa)
    const saved = getStop(numero);
    pendingSeek = saved && !saved.done && saved.t > 3 && (!knownDuration || saved.t < knownDuration - 3) ? saved.t : 0;

    // Invio evento a Google Analytics (GA4)
    gtag('event', 'play_audio', {
      'audio_title': titolo,
      'audio_id': numero,
      'audio_src': src
    });

    try {
      // FONDAMENTALE: Aggiriamo il blocco delle "Range Requests" di Safari e Workbox
      // effettuando una normale fetch(). Workbox intercetterà questa fetch e
      // restituirà istantaneamente il file MP3 intero dalla cache locale.
      const response = await fetch(resolvedSrc);
      const blob = await response.blob();

      // Durante la fetch l'utente può aver scelto un'altra tappa: questa risposta è obsoleta
      if (currentTrackSrc !== resolvedSrc) return;

      const objectUrl = URL.createObjectURL(blob);

      // Pulizia della memoria dal blob precedente
      if (audio.src && audio.src.startsWith('blob:')) {
        URL.revokeObjectURL(audio.src);
      }

      audio.src = objectUrl;
      audio.load();
      applyRate(audio.defaultPlaybackRate || getRate());
      audio.play().catch(() => {/* browser may block autoplay */});
    } catch (err) {
      // Fallback tradizionale
      if (currentTrackSrc !== resolvedSrc) return;
      if (audio.src !== resolvedSrc) {
        if (audio.src && audio.src.startsWith('blob:')) {
          URL.revokeObjectURL(audio.src);
        }
        audio.src = resolvedSrc;
        audio.load();
      }
      applyRate(audio.defaultPlaybackRate || getRate());
      audio.play().catch(() => {/* browser may block autoplay */});
    }
  });

  // Listen for toggle-play events
  audioStore.addEventListener('toggle-play', () => {
    if (audio.paused) {
      audio.play().catch(() => {});
    } else {
      audio.pause();
    }
  });

  // Listen for seek-relative events
  audioStore.addEventListener('seek-relative', (e: Event) => {
    const { seconds } = (e as CustomEvent<{ seconds: number }>).detail;
    const max = effectiveDuration() || Infinity;
    audio.currentTime = Math.max(0, Math.min(max, audio.currentTime + seconds));
  });

  // The player persists across View Transitions but the body is swapped,
  // so re-apply the spacing class when the player is still visible.
  document.addEventListener('astro:after-swap', () => {
    if (player.classList.contains('is-on')) {
      document.body.classList.add('player-active');
    }
  });

  function goTo(s: (typeof audioguides)[number] | null, andNavigate: boolean): void {
    if (!s) return;
    audioStore.playTappa(infoFor(s));
    if (andNavigate && location.pathname !== `/tappa/${s.id}/`) navigate(`/tappa/${s.id}/`);
  }

  // Player button handlers
  btnPlay.addEventListener('click', () => audioStore.togglePlay());
  btnBack.addEventListener('click', () => audioStore.seekRelative(-15));
  btnFwd.addEventListener('click', () => audioStore.seekRelative(15));
  btnNext.addEventListener('click', () => goTo(nextOf(currentId), true));
  btnRate.addEventListener('click', () => {
    const i = RATES.indexOf(audio.playbackRate);
    const r = RATES[(i + 1) % RATES.length];
    applyRate(r);
    setRate(r);
    updatePositionState();
  });

  // Comandi dalla schermata di blocco / cuffie
  if ('mediaSession' in navigator) {
    const ms = navigator.mediaSession;
    const set = (a: MediaSessionAction, h: MediaSessionActionHandler) => {
      try { ms.setActionHandler(a, h); } catch { /* azione non supportata */ }
    };
    set('play', () => audio.play().catch(() => {}));
    set('pause', () => audio.pause());
    set('seekbackward', (d) => audioStore.seekRelative(-(d.seekOffset || 15)));
    set('seekforward', (d) => audioStore.seekRelative(d.seekOffset || 15));
    set('seekto', (d) => { if (d.seekTime != null) audio.currentTime = d.seekTime; });
    set('nexttrack', () => goTo(nextOf(currentId), document.visibilityState === 'visible'));
    set('previoustrack', () => goTo(prevOf(currentId), document.visibilityState === 'visible'));
  }

  // Sync progress bar with audio
  audio.addEventListener('timeupdate', () => {
    const d = effectiveDuration();
    if (d > 0) {
      setProgress(audio.currentTime, d);
      audioStore.reportProgress(audio.currentTime, d, currentTrackSrc || audio.src);
      persist();
    }
  });

  audio.addEventListener('loadedmetadata', () => {
    elDuration.textContent = fmtTime(effectiveDuration());
    if (pendingSeek > 0) {
      audio.currentTime = pendingSeek;
      pendingSeek = 0;
    }
    updatePositionState();
  });

  // Duration may only become known after buffering; update the display then.
  audio.addEventListener('durationchange', () => {
    if (isFinite(audio.duration) && audio.duration > 0) {
      elDuration.textContent = fmtTime(audio.duration);
    }
  });

  audio.addEventListener('ratechange', updatePositionState);
  audio.addEventListener('seeked', updatePositionState);

  audio.addEventListener('play', () => {
    setPlayingUI(true);
    player.classList.remove('is-ended');
    audioStore.reportState(true, currentTrackSrc || audio.src);
    updatePositionState();
  });

  audio.addEventListener('pause', () => {
    setPlayingUI(false);
    const dur = effectiveDuration();
    const isEnd = dur > 0 && audio.currentTime >= dur - 0.5;
    if (!isEnd) persist(true);
    audioStore.reportState(false, currentTrackSrc || audio.src);

    // Invia evento di pausa (escludendo quando l'audio è terminato)
    if (dur > 0 && !isEnd) {
      gtag('event', 'audio_pause', {
        'audio_title': elTitolo.textContent,
        'audio_id': currentId,
        'audio_position': Math.round(audio.currentTime)
      });
    }
  });

  audio.addEventListener('ended', () => {
    setPlayingUI(false);
    if (currentId) markDone(currentId);
    setProgress(0, effectiveDuration());
    audio.currentTime = 0;
    player.classList.add('is-ended');
    audioStore.reportState(false, currentTrackSrc || audio.src);

    // Invia evento di completamento audio
    gtag('event', 'audio_complete', {
      'audio_title': elTitolo.textContent,
      'audio_id': currentId,
      'audio_src': currentTrackSrc || audio.src
    });
  });

  // Allow scrubbing via progress bar
  progressBar.addEventListener('input', () => {
    const d = effectiveDuration();
    if (d > 0) {
      audio.currentTime = (Number(progressBar.value) / 100) * d;
      progressBar.style.setProperty('--p', `${progressBar.value}%`);
    }
  });

  // Non perdere la posizione se la pagina viene chiusa o messa in background
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') persist(true);
  });
</script>

<style>
  .pl {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: var(--f-bg);
    color: var(--f-ink);
    border-top: 1px solid var(--f-line);
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease-out;
  }

  .pl.is-on {
    transform: none;
    opacity: 1;
    pointer-events: auto;
  }

  .pl-in {
    max-width: 40rem;
    margin-inline: auto;
    padding: 0 var(--gutter) calc(0.5rem + env(safe-area-inset-bottom, 0px));
  }

  /* Barra di avanzamento: sottile e squadrata, area di tocco alta */
  .pl-bar {
    --p: 0%;
    display: block;
    width: 100%;
    height: 2.75rem;
    margin: 0;
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
  }

  .pl-bar::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(to right, var(--f-red) var(--p), var(--f-line) var(--p));
  }

  .pl-bar::-moz-range-track {
    height: 2px;
    background: var(--f-line);
  }

  .pl-bar::-moz-range-progress {
    height: 2px;
    background: var(--f-red);
  }

  .pl-bar::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -5px;
    border-radius: 0;
    border: 0;
    background: var(--f-ink);
  }

  .pl-bar::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 0;
    border: 0;
    background: var(--f-ink);
  }

  .pl-bar:focus-visible {
    outline: 2px solid var(--f-red);
    outline-offset: 0;
  }

  .pl-info {
    margin-top: -0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .pl-now {
    display: flex;
    gap: 0.6rem;
    min-width: 0;
    min-height: var(--tap);
    align-items: center;
    text-decoration: none;
    color: var(--f-ink);
  }

  .pl-now:hover {
    color: var(--f-red);
  }

  .pl-num {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--f-red);
    flex: none;
  }

  .pl-title {
    font-size: 1.05rem;
    font-weight: 500;
    font-variation-settings: 'opsz' 36;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pl-time {
    flex: none;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--f-soft);
  }

  .pl-sep {
    opacity: 0.6;
  }

  .pl-ctrl {
    display: grid;
    grid-template-columns: 1fr 1fr auto 1fr 1fr;
    align-items: center;
    gap: 0.25rem;
  }

  .pl-btn {
    min-height: var(--tap);
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    color: var(--f-ink);
    font-family: var(--mono);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .pl-btn:hover:not(:disabled) {
    color: var(--f-red);
  }

  .pl-btn:disabled {
    color: var(--f-soft);
    opacity: 0.5;
    cursor: default;
  }

  .pl-btn:focus-visible,
  .pl-play:focus-visible {
    outline: 2px solid var(--f-red);
    outline-offset: 2px;
  }

  .pl-next {
    border: 1px solid transparent;
  }

  /* A fine traccia la tappa successiva diventa l'azione evidente */
  .pl.is-ended .pl-next:not(:disabled) {
    border-color: var(--f-red);
    color: var(--f-red);
  }

  .pl-play {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-inline: 0.5rem;
    border: 1px solid var(--f-red);
    background: var(--f-red);
    color: var(--f-bg);
    cursor: pointer;
  }

  .pl-play:hover {
    background: var(--f-ink);
    border-color: var(--f-ink);
  }

  .pl-play svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .pl-play path {
    vector-effect: non-scaling-stroke;
  }

  .pl-play svg.is-hidden {
    display: none;
  }
</style>
