---
// Disegno a tratto del percorso: curve di livello + tracciato tratteggiato
// con una tacca quadrata per tappa. È uno SCHEMA (non una pianta in scala):
// la tappa 7 "Sommità" sta in cima al rilievo, le altre la avvicinano.
import { contours } from '../lib/contours';
import { pad } from '../i18n/ui';

interface Props {
  ids: number[];
  caption: string;
}

const { ids, caption } = Astro.props;

const W = 400;
const H = 340;
const lines = contours({ cx: 252, cy: 158, levels: 15, r0: 10, step: 15, seed: 11 });

// Posizioni schematiche delle tacche (stessa sequenza dell'elenco)
const anchors: [number, number][] = [
  [52, 300],
  [118, 262],
  [92, 204],
  [162, 176],
  [204, 226],
  [290, 240],
  [252, 152],
  [336, 176],
];
const pts = ids.map((id, i) => ({ id, x: anchors[i % anchors.length][0], y: anchors[i % anchors.length][1] }));

// Tracciato aperto lisciato (Catmull-Rom)
let route = `M${pts[0].x},${pts[0].y}`;
for (let i = 0; i < pts.length - 1; i++) {
  const p0 = pts[Math.max(0, i - 1)];
  const p1 = pts[i];
  const p2 = pts[i + 1];
  const p3 = pts[Math.min(pts.length - 1, i + 2)];
  const c1x = p1.x + (p2.x - p0.x) / 6;
  const c1y = p1.y + (p2.y - p0.y) / 6;
  const c2x = p2.x - (p3.x - p1.x) / 6;
  const c2y = p2.y - (p3.y - p1.y) / 6;
  route += ` C${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${p2.x},${p2.y}`;
}

// Frazione di percorso raggiunta a ogni tacca (approssimata sulla spezzata)
const seg = pts.map((p, i) => (i === 0 ? 0 : Math.hypot(p.x - pts[i - 1].x, p.y - pts[i - 1].y)));
const total = seg.reduce((a, b) => a + b, 0);
let acc = 0;
const fracs = seg.map((l) => ((acc += l), +(acc / total).toFixed(4)));

// Tacche di griglia ai bordi (linguaggio da tavola di rilievo)
const ticks = Array.from({ length: 9 }, (_, i) => 20 + i * 45);
---

<figure class="route" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="presentation" focusable="false">
    <g class="ct">
      {lines.map((l) => <path d={l.d} class={l.major ? 'maj' : ''} />)}
    </g>
    <g class="tk">
      {ticks.map((x) => <path d={`M${x},0 v6 M${x},${H} v-6`} />)}
      {ticks.filter((y) => y < H).map((y) => <path d={`M0,${y} h6 M${W},${y} h-6`} />)}
    </g>
    <path class="rt" d={route} />
    <path class="rt-done" d={route} data-route-done data-fracs={JSON.stringify(fracs)} pathLength="1" style="stroke-dasharray: 0 1" />
    {
      pts.map((p) => (
        <g class="stop" data-stop-mark={p.id} transform={`translate(${p.x} ${p.y})`}>
          <rect x="-4.5" y="-4.5" width="9" height="9" />
          <text x="9" y="-7">{pad(p.id)}</text>
        </g>
      ))
    }
  </svg>
  <figcaption class="mono">{caption}</figcaption>
</figure>

<style>
  .route {
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  path,
  rect {
    vector-effect: non-scaling-stroke;
  }

  .ct path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.8;
    opacity: 0.13;
  }

  .ct path.maj {
    stroke-width: 1.1;
    opacity: 0.26;
  }

  .tk path {
    stroke: var(--ink);
    stroke-width: 1;
    opacity: 0.35;
  }

  .rt {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-dasharray: 2 7;
    stroke-linecap: square;
  }

  .rt-done {
    fill: none;
    stroke: var(--stamp);
    stroke-width: 1.4;
    transition: stroke-dasharray 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stop rect {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
    transition: fill 0.3s ease-out, stroke 0.3s ease-out;
  }

  .stop text {
    font-family: var(--mono);
    font-size: 11px;
    fill: var(--ink-soft);
  }

  .stop.is-done rect {
    fill: var(--stamp);
    stroke: var(--stamp);
  }

  .stop.is-current rect {
    fill: var(--paper);
    stroke: var(--stamp);
    stroke-width: 1.4;
  }

  .stop.is-current text,
  .stop.is-done text {
    fill: var(--stamp);
  }

  figcaption {
    margin-top: 0.4rem;
    color: var(--ink-soft);
    font-size: 0.75rem;
  }
</style>
