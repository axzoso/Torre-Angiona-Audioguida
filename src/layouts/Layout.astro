---
import { ClientRouter } from 'astro:transitions';
import AudioPlayer from '../components/AudioPlayer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Torre Angioina — Audioguida',
  description = 'Audioguida per la Torre Angioina di San Marco Argentano, XIII secolo.',
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <!-- Google tag (gtag.js) - Configurazione Strictly Anonymous -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4GFKQ1B6XE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Blindatura Privacy per conformità senza Banner
      gtag('config', 'G-4GFKQ1B6XE', {
        'anonymize_ip': true,                // Anonimizzazione IP (già nativa ma esplicitata)
        'allow_google_signals': false,       // Disattiva profilazione cross-device e pubblicitaria
        'allow_ad_personalization_signals': false, // Blocca la personalizzazione degli annunci
        'restricted_data_processing': true,  // Forza il trattamento dati restrittivo (GDPR)
        'client_storage': 'none'             // IMPEDISCE a GA4 di salvare cookie persistenti sul telefono
      });

      // Tracciamento dei cambi pagina compatibile con ClientRouter
      document.addEventListener('astro:page-load', () => {
        if (typeof gtag === 'function') {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
      });
    </script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-[#0A0A0A] text-[#F5F0EB] min-h-screen antialiased flex flex-col">
    <main class="flex-1">
      <slot />
    </main>
    <footer class="px-5 py-6 text-center border-t" style="border-color: var(--glass-border)">
      <p class="text-xs" style="color: var(--text-secondary)">
        Torre Angioina di San Marco Argentano<br />
        <span class="opacity-50">Audioguida · versione digitale</span>
      </p>
      <p class="text-xs text-gray-500 mt-4">© {new Date().getFullYear()} Associazione Fuori le Mura — Comune di San Marco Argentano</p>
      <a href="/privacy" class="text-[#E0A96D] hover:underline mt-2 inline-block text-xs transition-colors">Informativa sulla Privacy</a>
    </footer>
    <AudioPlayer />
  </body>
</html>
