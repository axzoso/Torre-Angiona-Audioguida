---
import { ClientRouter } from 'astro:transitions';
import AudioPlayer from '../components/AudioPlayer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Torre Angioina — Audioguida',
  description = 'Audioguida per la Torre Angioina di San Marco Argentano, XIII secolo.',
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4GFKQ1B6XE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4GFKQ1B6XE');

      // Forza il tracciamento di GA4 ad ogni cambio pagina simulato da Astro
      document.addEventListener('astro:page-load', () => {
        if (typeof gtag === 'function') {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
      });
    </script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-[#0A0A0A] text-[#F5F0EB] min-h-screen antialiased">
    <main class="pb-28">
      <slot />
    </main>
    <AudioPlayer />
  </body>
</html>
