---
import { ClientRouter } from 'astro:transitions';
import AudioPlayer from '../components/AudioPlayer.astro';
import { t, lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Testo contestuale a destra dell'header (es. "Tappa 3 di 8") */
  context?: string;
}

const {
  title = `${t.appName} — Audioguida della Torre Angioina`,
  description = 'Audioguida Torre Viva per la Torre Angioina di San Marco Argentano, XIII secolo.',
  context,
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!--
      Content-Security-Policy a livello applicativo (via meta, così vive insieme
      al codice che la richiede). Difesa in profondità: anche se
      un terzo (Google Analytics) venisse compromesso, può caricare risorse solo
      dai domini elencati. Il cuore dell'app è tutto 'self' + blob:, quindi se
      questa policy fosse troppo stretta al più smette GA, non l'audioguida.
      Nota: 'unsafe-inline' è necessario per gli stili inline e per lo snippet
      gtag inline; 'frame-ancestors' non è esprimibile via meta → il clickjacking
      è coperto da X-Frame-Options e frame-ancestors in public/_headers.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efe9db" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={t.appName} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <!-- Google tag (gtag.js) - Configurazione Strictly Anonymous -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4GFKQ1B6XE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Blindatura Privacy per conformità senza Banner
      gtag('config', 'G-4GFKQ1B6XE', {
        'send_page_view': false,             // page_view inviato solo da astro:page-load (altrimenti il primo caricamento conta doppio)
        'anonymize_ip': true,                // Anonimizzazione IP (già nativa ma esplicitata)
        'allow_google_signals': false,       // Disattiva profilazione cross-device e pubblicitaria
        'allow_ad_personalization_signals': false, // Blocca la personalizzazione degli annunci
        'restricted_data_processing': true,  // Forza il trattamento dati restrittivo (GDPR)
        'client_storage': 'none'             // IMPEDISCE a GA4 di salvare cookie persistenti sul telefono
      });

      // Tracciamento dei cambi pagina compatibile con ClientRouter
      document.addEventListener('astro:page-load', () => {
        if (typeof gtag === 'function') {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
      });
    </script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#contenuto">{t.skip}</a>

    <header class="hd">
      <div class="hd-in sheet">
        <a class="mark" href="/" aria-label={`${t.appName} — ${t.backHome}`}>
          {t.appName}
        </a>
        <span class="hd-ctx mono soft">{context ?? t.org}</span>
      </div>
    </header>

    <main id="contenuto">
      <slot />
    </main>

    <footer class="ft">
      <div class="ft-in sheet">
        <p class="ft-name">{t.org}</p>
        <div class="ft-cols">
          <p class="ft-tag">
            {t.appName} è l’audioguida della Torre Angioina di San Marco Argentano, gestita dall’Associazione Fuori le Mura.
          </p>
          <ul class="ft-links mono">
            <li><a href="/privacy/">{t.privacy}</a></li>
            <li><a href="#contenuto">↑ {t.backTop}</a></li>
          </ul>
        </div>
        <p class="ft-legal mono">© {year} {t.credits}</p>
      </div>
    </footer>

    <AudioPlayer />

    <script>
      import { registerSW } from 'virtual:pwa-register';
      import audioguides from '../data/audioguides.json';

      // Registrazione esplicita del Service Worker per essere sicuri al 100%
      if (typeof window !== 'undefined' && 'serviceWorker' in navigator) {
        registerSW({ immediate: true });

        // Strategia di Pre-buffering / Warm-up (Background Audio Caching)
        window.addEventListener('load', () => {
          // Attende che la CPU sia inattiva per non bloccare il thread principale
          const idleCallback = window.requestIdleCallback || ((cb) => setTimeout(cb, 2000));

          idleCallback(async () => {
            if (!navigator.onLine) return; // Evita di forzare richieste se siamo già offline

            // Alla prima visita la pagina non è ancora controllata dal service
            // worker: i fetch partiti prima del controllo non passano dalla
            // cache 'audio-cache' e quegli audio poi mancano offline (su iPhone
            // la prima tappa). Si aspetta il controllo (clientsClaim) prima di
            // partire; se non arriva entro 15 s si rinuncia, al prossimo
            // caricamento si riprova.
            const sw = navigator.serviceWorker;
            await sw.ready;
            if (!sw.controller) {
              const controllato = await new Promise((resolve) => {
                const timer = setTimeout(() => resolve(false), 15000);
                sw.addEventListener('controllerchange', () => { clearTimeout(timer); resolve(true); }, { once: true });
              });
              if (!controllato) return;
            }

            try {
              for (const tappa of audioguides) {
                fetch(tappa.audioSrc, { priority: 'low' }).catch(() => {});
                await new Promise(r => setTimeout(r, 800));
              }
            } catch (err) {
              console.warn("Errore durante il pre-buffering:", err);
            }
          });
        });
      }
    </script>
  </body>
</html>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 40;
    background: linear-gradient(var(--paper) 62%, rgba(239, 233, 219, 0));
    padding-top: env(safe-area-inset-top, 0px);
  }

  .hd-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 72;
    text-decoration: none;
  }

  .hd-ctx {
    text-align: right;
  }

  /* Footer — tema scuro locale */
  .ft {
    margin-top: clamp(5rem, 12vw, 9rem);
    background: var(--f-bg);
    color: var(--f-ink);
    padding-block: clamp(3rem, 7vw, 5rem) calc(2rem + env(safe-area-inset-bottom, 0px));
  }

  .ft a:hover {
    color: var(--f-red);
  }

  .ft-in {
    max-width: 96rem;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .ft-name {
    margin: 0;
    font-size: clamp(3rem, 1rem + 8vw, 8.5rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-weight: 450;
    font-variation-settings: 'opsz' 144;
    hyphens: manual;
  }

  .ft-cols {
    display: grid;
    gap: 1.5rem;
  }

  .ft-tag {
    max-width: 30rem;
    margin: 0;
    color: var(--f-soft);
  }

  .ft-links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--f-line);
  }

  .ft-links li {
    border-bottom: 1px solid var(--f-line);
  }

  .ft-links a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
  }

  .ft-legal {
    margin: 0;
    color: var(--f-soft);
  }

  @media (min-width: 52rem) {
    .ft-cols {
      grid-template-columns: minmax(0, 30rem) minmax(0, 18rem);
      justify-content: space-between;
      align-items: start;
    }
  }
</style>
