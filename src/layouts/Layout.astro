---
import { ClientRouter } from 'astro:transitions';
import AudioPlayer from '../components/AudioPlayer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Torre Angioina — Audioguida',
  description = 'Audioguida per la Torre Angioina di San Marco Argentano, XIII secolo.',
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!--
      Content-Security-Policy a livello applicativo (via meta, perché nginx.conf
      è gestito da Coolify e non va modificato). Difesa in profondità: anche se
      un terzo (Google Analytics) venisse compromesso, può caricare risorse solo
      dai domini elencati. Il cuore dell'app è tutto 'self' + blob:, quindi se
      questa policy fosse troppo stretta al più smette GA, non l'audioguida.
      Nota: 'unsafe-inline' è necessario per gli stili inline e per lo snippet
      gtag inline; 'frame-ancestors'/X-Frame-Options vanno impostati su Cloudflare.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <!-- Google tag (gtag.js) - Configurazione Strictly Anonymous -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4GFKQ1B6XE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Blindatura Privacy per conformità senza Banner
      gtag('config', 'G-4GFKQ1B6XE', {
        'anonymize_ip': true,                // Anonimizzazione IP (già nativa ma esplicitata)
        'allow_google_signals': false,       // Disattiva profilazione cross-device e pubblicitaria
        'allow_ad_personalization_signals': false, // Blocca la personalizzazione degli annunci
        'restricted_data_processing': true,  // Forza il trattamento dati restrittivo (GDPR)
        'client_storage': 'none'             // IMPEDISCE a GA4 di salvare cookie persistenti sul telefono
      });

      // Tracciamento dei cambi pagina compatibile con ClientRouter
      document.addEventListener('astro:page-load', () => {
        if (typeof gtag === 'function') {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
      });
    </script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-[#0A0A0A] text-[#F5F0EB] min-h-screen antialiased flex flex-col">
    <main class="flex-1">
      <slot />
    </main>
    <footer class="px-5 py-6 text-center border-t" style="border-color: var(--glass-border)">
      <p class="text-xs" style="color: var(--text-secondary)">
        Torre Angioina di San Marco Argentano<br />
        <span class="opacity-50">Audioguida · versione digitale</span>
      </p>
      <p class="text-xs text-gray-500 mt-4">© {new Date().getFullYear()} Associazione Fuori le Mura — Comune di San Marco Argentano</p>
      <a href="/privacy/" class="text-[#E0A96D] hover:underline mt-2 inline-block text-xs transition-colors">Informativa sulla Privacy</a>
    </footer>
    <AudioPlayer />
    <script>
      import { registerSW } from 'virtual:pwa-register';
      
      // Registrazione esplicita del Service Worker per essere sicuri al 100%
      if (typeof window !== 'undefined' && 'serviceWorker' in navigator) {
        registerSW({ immediate: true });

        // Strategia di Pre-buffering / Warm-up (Background Audio Caching)
        window.addEventListener('load', () => {
          // Attende che la CPU sia inattiva per non bloccare il thread principale
          const idleCallback = window.requestIdleCallback || ((cb) => setTimeout(cb, 2000));
          
          idleCallback(async () => {
            if (!navigator.onLine) return; // Evita di forzare richieste se siamo già offline
            
            try {
              const tappe = [1, 2, 3, 4, 5, 6, 7, 8];
              for (const t of tappe) {
                const url = `/audio/tappa${t}.mp3`;
                fetch(url, { priority: 'low' }).catch(() => {});
                await new Promise(r => setTimeout(r, 800));
              }
            } catch (err) {
              console.warn("Errore durante il pre-buffering:", err);
            }
          });
        });
      }
    </script>
  </body>
</html>
